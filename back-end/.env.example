MCP_SERVER_NAME="agent-mcp-server"
MCP_SERVER_VERSION="0.1.0"
LOG_LEVEL="info"
MCP_TRANSPORT="stdio"
MCP_RATE_LIMIT_PER_MINUTE="60"
AUTH_MODE="local_sqlite"
SQLITE_DATABASE_PATH=".local/ine-explora.sqlite"
LOCAL_ACTOR_ID="10000000-0000-4000-8000-000000000001"
# Release local verificado por scripts/prepare-data-release.sh.
CCPC_DATA_DIR="../data-release/Ine-hacktoon-DATA-06"
CCPC_DATASET_PATH="data/ccpc/full/participation.compact.json"
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="replace-with-supabase-publishable-key"
SUPABASE_ACCESS_TOKEN="replace-with-authenticated-user-access-token"
GEMINI_API_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_TIMEOUT_MS="60000"

# Planificador de la interfaz: rules (sin conexión), local-model o gemini.
UI_PLANNER_MODE="rules"
# Sólo para local-model: servidor compatible con OpenAI en este equipo (por ejemplo Ollama).
LOCAL_MODEL_URL=""
LOCAL_MODEL_NAME=""
LOCAL_MODEL_TIMEOUT_MS="4000"

ELEVENLABS_API_KEY="replace-with-elevenlabs-api-key"
ELEVENLABS_STT_MODEL="scribe_v2_realtime"
ELEVENLABS_STT_LANGUAGE="es"
ELEVENLABS_STT_COMMIT_STRATEGY="vad"
ELEVENLABS_STT_VAD_SILENCE_SECONDS="1"
ELEVENLABS_STT_VAD_THRESHOLD="0.4"
ELEVENLABS_STT_MIN_SPEECH_MS="100"
ELEVENLABS_STT_MIN_SILENCE_MS="100"
ELEVENLABS_STT_INCLUDE_TIMESTAMPS="false"
ELEVENLABS_STT_ECHO_CANCELLATION="true"
ELEVENLABS_STT_NOISE_SUPPRESSION="true"
ELEVENLABS_STT_AUTO_GAIN_CONTROL="true"
ELEVENLABS_STT_TIMEOUT_MS="10000"
AGENT_MAX_TOOL_CALLS="6"
AGENT_TOOL_TIMEOUT_MS="12000"
AGENT_TOOL_MAX_RETRIES="1"
AGENT_RETRY_DELAY_MS="200"
AGENT_API_HOST="127.0.0.1"
AGENT_API_PORT="3101"
AGENT_API_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
AGENT_AUTH_RATE_LIMIT_PER_MINUTE="60"
AGENT_API_RATE_LIMIT_PER_MINUTE="20"
AGENT_API_TOKEN="replace-with-at-least-32-random-characters"
